---
// Formas decorativas de juguete (SVG en línea, sin dependencias): nube, estrella, sol, cometa y garabato.
// Toman el color de `currentColor` (pon `text-acento`, `text-primario`… o un color en CSS). Siempre decorativas:
// llevan aria-hidden y no tienen texto. Tamaño y posición con la clase que les pases.
interface Props { tipo?: 'nube' | 'estrella' | 'sol' | 'cometa' | 'garabato'; class?: string }
const { tipo = 'estrella', class: clase = '' } = Astro.props;

const formas: Record<string, { caja: string; cuerpo: string }> = {
  nube: {
    caja: '0 -14 120 84',
    cuerpo: '<path fill="currentColor" d="M28 68a24 24 0 0 1-3.5-47.7A30 30 0 0 1 82 14a22 22 0 0 1 14 9.5A22.5 22.5 0 0 1 96.5 68z"/>',
  },
  estrella: {
    caja: '0 0 100 100',
    cuerpo: '<path fill="currentColor" stroke="currentColor" stroke-width="10" stroke-linejoin="round" d="M50 8l12 28 30 2.5-23 19.5 7.5 29.5L50 71.5 23.5 87.5 31 58 8 38.5 38 36z"/>',
  },
  sol: {
    caja: '0 0 100 100',
    cuerpo:
      '<circle cx="50" cy="50" r="24" fill="currentColor"/><g stroke="currentColor" stroke-width="7" stroke-linecap="round">' +
      '<path d="M50 6v12M50 82v12M6 50h12M82 50h12M19 19l8.5 8.5M72.5 72.5L81 81M19 81l8.5-8.5M72.5 27.5L81 19"/></g>',
  },
  cometa: {
    caja: '0 0 100 140',
    cuerpo:
      '<path fill="currentColor" d="M50 4l38 42-38 52-38-52z"/>' +
      '<path fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" d="M50 98c-10 10 10 16 0 26s8 12 4 14"/>',
  },
  garabato: {
    caja: '0 0 160 40',
    cuerpo: '<path fill="none" stroke="currentColor" stroke-width="7" stroke-linecap="round" d="M6 26c12-18 22-18 30 0s20 18 30 0 20-18 30 0 20 18 30 0 18-14 28-6"/>',
  },
};
const f = formas[tipo] ?? formas.estrella;
---

<svg class={clase} viewBox={f.caja} aria-hidden="true" focusable="false" set:html={f.cuerpo} />
