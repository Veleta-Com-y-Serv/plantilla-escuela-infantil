---
// Preguntas frecuentes: banda crema; titular a la izquierda (con `cta` opcional y una cometa decorativa) y acordeón
// nativo <details>/<summary> a la derecha, sin JavaScript, con burbujas gorditas que se tiñen de acento al abrirse.
// Campos: `preguntas[]` (pregunta, respuesta).
import { seccion } from '../../data/site';
import Titular from '../ui/Titular.astro';
import Forma from '../ui/Forma.astro';
interface Props { id: string }
const { id } = Astro.props;
const s = seccion(id);
const preguntas = s ? s.preguntas.filter((p) => p && p.pregunta) : [];
---

{
  s && preguntas.length > 0 && (
    <section id={id} class="banda banda-crema seccion">
      <div class="contenedor grid gap-10 lg:grid-cols-12 lg:gap-16">
        <div class="relative lg:col-span-5">
          <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} class="!mb-0" />
          {s.cta?.url && <a class="btn mt-9" href={s.cta.url}>{s.cta.texto}</a>}
          <Forma tipo="cometa" class="mt-14 hidden w-24 rotate-[-14deg] text-[var(--verde)] lg:block" />
        </div>
        <div class="grid content-start gap-3.5 lg:col-span-7">
          {preguntas.map((p, i) => (
            <details class="faq" open={i === 0}>
              <summary>
                {p.pregunta}
                <span class="faq-signo" aria-hidden="true">+</span>
              </summary>
              <p>{p.respuesta}</p>
            </details>
          ))}
        </div>
      </div>
    </section>
  )
}
